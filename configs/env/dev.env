# =============================================================
# dev 环境变量预设（**非敏感**）
#
# 用法：cp configs/env/dev.env .env
# 说明：真正的运行时配置始终读仓库根的 .env（pydantic-settings 默认行为），
#       本目录只提供各环境的**版本化预设**，避免「每台机器各写一份 .env」
#       导致环境差异无法 review。
#       密钥类字段（DEEPSEEK_API_KEY 等）一律留空，由密钥管理系统或本地手填。
# =============================================================

APP_ENV=dev
LOG_LEVEL=DEBUG

# ---- LLM：dev 默认走本地 OpenAI 兼容端点（Ollama / vLLM），无需外网与密钥 ----
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3.5:4b
# 本地思考型模型必须关掉思考链，否则输出预算被思维链吃光、content 为空
LOCAL_LLM_API_STYLE=ollama
LOCAL_LLM_THINK=false
DEEPSEEK_API_KEY=

# ---- 向量化：本地 ONNX，避免 dev 依赖外部服务 ----
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512

# ---- 存储（本机 compose 直连）----
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
MILVUS_URI=http://localhost:19530
OPENSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0

# ---- 关闭一切「增益但未验证」的能力 ----
USE_KAFKA=false
AUTHZ_ENABLED=false
CACHE_ENABLED=false
RERANK_ENABLED=false
REWRITE_ENABLED=false

# ---- 检索 ----
RETRIEVE_MODE=hybrid
TOP_K=5

# ---- 基础设施端口（docker compose 宿主映射；本机冲突时改这里）----
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091

# =============================================================
# staging 环境变量预设（结构与 prod 保持一致，仅容量与地址不同）
#
# 与 prod 同构才具备「变更预演」的意义：如果 staging 关掉了鉴权或缓存，
# 那么生产上第一次打开它们时就等于第一次测试。
# =============================================================

APP_ENV=staging
LOG_LEVEL=INFO

# ---- LLM：走官方 API（密钥由密钥管理系统注入）----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_FALLBACK_MODELS=local
LOCAL_LLM_BASE_URL=http://llm-local.rag-staging.svc.cluster.local:8000/v1
LOCAL_LLM_MODEL=deepseek-r1:7b

EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512

# ---- 存储（集群内 DNS）----
DATABASE_URL=postgresql+asyncpg://rag:__REPLACE__@rag-postgres-postgresql.rag-staging.svc.cluster.local:5432/rag
MILVUS_URI=http://rag-milvus.rag-staging.svc.cluster.local:19530
OPENSEARCH_URL=http://rag-opensearch.rag-staging.svc.cluster.local:9200
REDIS_URL=redis://rag-redis-master.rag-staging.svc.cluster.local:6379/0

# ---- 能力开关：与 prod 一致 ----
USE_KAFKA=true
AUTHZ_ENABLED=true
CACHE_ENABLED=true
RERANK_ENABLED=false
REWRITE_ENABLED=false

KEYCLOAK_URL=http://rag-keycloak-keycloakx-http.rag-staging.svc.cluster.local:8080
KEYCLOAK_REALM=rag
OPA_URL=http://rag-opa.rag-staging.svc.cluster.local:8181
LANGFUSE_HOST=http://langfuse.rag-staging.svc.cluster.local:3000

RETRIEVE_MODE=hybrid
TOP_K=5
RATE_LIMIT_PER_MINUTE=120

# =============================================================
# prod 环境变量预设
#
# 注意：**本文件不存放真实密钥**。生产密钥通过 K8s Secret（existingSecret）
#       从密钥管理系统注入；这里的 __REPLACE__ 只是占位提示。
# =============================================================

APP_ENV=prod
LOG_LEVEL=INFO

# ---- LLM：官方 API 为主，本地端点作为兜底 ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LLM_FALLBACK_MODELS=local
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60
LOCAL_LLM_BASE_URL=http://llm-local.rag-prod.svc.cluster.local:8000/v1
LOCAL_LLM_MODEL=deepseek-r1:7b

EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_CACHE_ENABLED=true

# ---- 存储 ----
DATABASE_URL=postgresql+asyncpg://rag:__REPLACE__@rag-postgres-postgresql.rag-prod.svc.cluster.local:5432/rag
MILVUS_URI=http://rag-milvus.rag-prod.svc.cluster.local:19530
OPENSEARCH_URL=http://rag-opensearch.rag-prod.svc.cluster.local:9200
REDIS_URL=redis://rag-redis-master.rag-prod.svc.cluster.local:6379/0

# ---- 能力开关：生产全开（除重排，待 eval 基线建立后再开）----
USE_KAFKA=true
AUTHZ_ENABLED=true
CACHE_ENABLED=true
RERANK_ENABLED=false
REWRITE_ENABLED=false

KEYCLOAK_URL=http://rag-keycloak-keycloakx-http.rag-prod.svc.cluster.local:8080
KEYCLOAK_REALM=rag
KEYCLOAK_CLIENT_ID=rag-api
OPA_URL=http://rag-opa.rag-prod.svc.cluster.local:8181
LANGFUSE_HOST=http://langfuse.rag-prod.svc.cluster.local:3000

# ---- 检索与配额 ----
RETRIEVE_MODE=hybrid
TOP_K=5
VECTOR_TOP_K=30
BM25_TOP_K=30
RRF_K=60
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
QUOTA_ENABLED=true
QUOTA_DAILY_TOKENS=2000000

# ---- 切分 ----
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_FILE_SIZE_MB=32

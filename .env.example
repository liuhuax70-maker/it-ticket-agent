# ===================== 应用 =====================
APP_ENV=dev
APP_NAME=it-ticket-assistant
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===================== Milvus =====================
# 在 docker-compose 内运行时用服务名 milvus；
# 本地直接 uvicorn 运行时改为 localhost
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks

# ===================== Ollama / 生成 =====================
# docker-compose 内用 http://ollama:11434；本地直跑改为 http://localhost:11434
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=qwen3-embedding

# ===================== 检索参数 =====================
TOP_N_DENSE=20
TOP_N_SPARSE=20
TOP_N_FUSED=50
TOP_K=5
RRF_K=60
RERANK_ENABLED=false

# ===================== 编排 / 会话 =====================
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_PATH=./data/checkpoints.sqlite
SESSION_TTL_DAYS=7

# ===================== 可观测（LangSmith） =====================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=it-ticket-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===================== 安全 =====================
IDEMPOTENCY_TTL_HOURS=24

# ===================== 应用 =====================
APP_ENV=dev
APP_NAME=it-ticket-assistant
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===================== Milvus =====================
# 本文件面向「本地直跑」（uvicorn）；
# docker-compose 内的 api 服务会以容器网络覆盖为 MILVUS_HOST=milvus
# 用 127.0.0.1 而非 localhost：后者可能优先解析到 IPv6 ::1 导致连接挂起
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks

# ===================== Ollama / 生成 =====================
# docker-compose 内的 api 服务会覆盖为 http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
RERANKER_MODEL=dengcao/Qwen3-Reranker-4B:Q5_K_M

# ===================== 检索参数 =====================
TOP_N_DENSE=20
TOP_N_SPARSE=20
TOP_N_FUSED=50
TOP_K=5
RRF_K=60
RERANK_ENABLED=false

# ===================== 编排 / 会话 =====================
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_PATH=./data/checkpoints.sqlite
SESSION_TTL_DAYS=7

# ===================== 可观测（LangSmith） =====================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=it-ticket-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===================== 安全 =====================
IDEMPOTENCY_TTL_HOURS=24

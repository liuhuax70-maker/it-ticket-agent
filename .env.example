# ===================== 应用 =====================
APP_ENV=dev
APP_NAME=it-ticket-assistant
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# ===================== Milvus =====================
# 本文件面向「本地直跑」（uvicorn）；
# docker-compose 内的 api 服务会以容器网络覆盖为 MILVUS_HOST=milvus
# 用 127.0.0.1 而非 localhost：后者可能优先解析到 IPv6 ::1 导致连接挂起
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_chunks

# ===================== Ollama / 生成 =====================
# docker-compose 内的 api 服务会覆盖为 http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
RERANKER_MODEL=dengcao/Qwen3-Reranker-4B:Q5_K_M

# ===================== 检索参数 =====================
TOP_N_DENSE=20
TOP_N_SPARSE=20
TOP_N_FUSED=50
# TOP_K=8 由 evaluation/run_param_sweep.py 扫出（k=8 时 Recall 95.8%，之后进入平台期）
TOP_K=8
RRF_K=60
RERANK_ENABLED=false
# 单通道超时（秒），超时即降级为另一通道；过低会导致稠密通道静默降级
CHANNEL_TIMEOUT_SECONDS=10.0
# 重排参数（逐条调用大模型，需限流）
RERANK_TOP_N=20
RERANK_MAX_WORKERS=4
RERANK_TIMEOUT_SECONDS=60.0

# ===================== 编排 / 会话 =====================
CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_PATH=./data/checkpoints.sqlite
SESSION_TTL_DAYS=7
# 敏感关键词（英文逗号分隔），命中即转人工审核
SENSITIVE_KEYWORDS=投诉,举报,起诉,法律,赔偿,泄露,数据丢失,安全事件,监管,停机事故,账号被盗
# 是否所有工单都要人工审核
REQUIRE_REVIEW_FOR_ALL=false

# ===================== 生成 =====================
LLM_TIMEOUT_SECONDS=300.0
# 输出 token 上限；0=不限制。本地生成延迟 ≈ 输出 token 数 ÷ 生成速率，限制输出最直接
LLM_NUM_PREDICT=0
# 模型保活时长；本地模型冷加载实测 12~13s，保活可避免每次请求重复加载
LLM_KEEP_ALIVE=30m
# 拼装上下文的最大字符预算；超出时按排名显式丢弃并记录日志（不交给模型静默截断）
CONTEXT_MAX_CHARS=6000

# ===================== 可观测（LangSmith） =====================
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=it-ticket-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ===================== 安全 =====================
IDEMPOTENCY_TTL_HOURS=24

# 复制为 .env 后按需填写；.env 已被 .gitignore 排除，不要提交真实密钥。

# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO

# ===== Milvus（docker compose 起的 standalone 实例）=====
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=chunks_p0
MILVUS_TIMEOUT=5

# ===== 向量化（P0 先用小模型跑通；换模型必须重建索引，维度需同步改）=====
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_BATCH_SIZE=32

# ===== LLM（OpenAI 兼容端点，P0 走外部服务）=====
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=60

# ===== Redis（P0 仅做 embedding 缓存）=====
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false

# ===== 本地编排端口（供 docker compose 读取；与已有服务冲突时改这里）=====
# 注意：改了 MILVUS_PORT 后，上面的 MILVUS_URI 要同步改
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
REDIS_PORT=6379

# ===== 数据与检索参数 =====
DATA_DIR=./data
DOCS_DIR=./docs_corpus
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=5

# ===== LangFuse（P0 可选，留空即不启用）=====
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

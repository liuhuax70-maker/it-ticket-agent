# =============================================================
# permission-aware-rag 环境变量样例
# 复制为 .env 后按需修改：cp .env.example .env
# 字段名即 Settings 字段名（大小写不敏感）
# =============================================================

# ---------- 通用 ----------
APP_ENV=dev
LOG_LEVEL=INFO

# ---------- 服务端口 ----------
API_GATEWAY_PORT=8000
QUERY_ORCHESTRATOR_PORT=8001
RETRIEVAL_PORT=8002
MODEL_GATEWAY_PORT=8003
INGESTION_PORT=8004
INDEXING_PORT=8005
EVAL_PORT=8006
FEEDBACK_PORT=8007
AUTHZ_PORT=8008

# ---------- 服务间地址（服务端到端调用） ----------
QUERY_ORCHESTRATOR_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002
MODEL_GATEWAY_URL=http://localhost:8003
INGESTION_URL=http://localhost:8004
INDEXING_URL=http://localhost:8005

# ---------- LLM（DeepSeek 双模可切换） ----------
# deepseek = 官方 API；local = 任意 OpenAI 兼容端点（Ollama / vLLM）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=deepseek-r1:7b
# openai = OpenAI 兼容 /v1 接口；ollama = Ollama 原生接口（支持关闭思考链）
LOCAL_LLM_API_STYLE=openai
# 思考型模型（qwen3 / deepseek-r1 等）在 CPU 上会把输出预算耗在思维链上、
# 最终 content 为空；本地跑 RAG 建议 style=ollama 且 think=false
LOCAL_LLM_THINK=false
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60
# 逗号分隔的兜底模型（如 deepseek/deepseek-chat,openai/gpt-4o-mini）
LLM_FALLBACK_MODELS=
# 回答提示模板版本（configs/prompts/rag_answer.<version>.txt）
# 注意：字段名没有 LLM_ 前缀（BaseAppSettings 未设 env_prefix）。
# 曾写成 LLM_ANSWER_PROMPT_VERSION，会被静默忽略。
# v6 = v5 + 允许**跨片段整合**与**用词对齐**：
#     用户问「请假」而资料分节写「病假/事假/年假」时照样作答（降级判据从
#     「有无逐字答案」改成「有无可用事实」）；v5 在这里过于严格，
#     会把能整合出来的答案误判成「资料没写」而降级。
# 未配置时代码默认也是 v6——别在此处留旧版本，否则注入防护/闲聊应答/多片段整合会静默消失。
# 回退到旧行为：ANSWER_PROMPT_VERSION=v4 并设 ANSWER_FALLBACK_ENABLED=false
ANSWER_PROMPT_VERSION=v6

# 检索为空、生成失败时的通用回答开关（命中资料时不受影响）。
# true ：知识库查不到也作答（区分寒暄 / 实质问题，见 configs/prompts/rag_fallback.v1.txt）
# false：退回历史行为，一律拒答
# 注意：生成失败（模型异常/截断）始终拒答，不受此开关影响。
ANSWER_FALLBACK_ENABLED=true

# ---------- Embedding ----------
# fastembed = 本地 ONNX（默认，无需外部服务）；litellm = 远端 OpenAI 兼容；sentence_transformers = 本地 torch
EMBED_BACKEND=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_BATCH_SIZE=32
EMBED_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
EMBED_CACHE_ENABLED=false

# ---------- Postgres ----------
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
# 查询缓存。缓存键含 tenant/department/user/temperature 四个维度（docs/adr/0006）：
# 少了身份维度会让同租户内不同部门共用一条答案，检索层 ACL 被整段绕过。
# 每次改变**影响答案内容**的配置后都要调大 CACHE_VERSION，让旧答案立刻失效：
# 更换作答模型（LLM_PROVIDER）、改提示词、改切分参数。键里放不进模型名
# （编排层不知道下游用哪个模型），所以靠这个显式版本号作废。
CACHE_VERSION=1
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# ---------- Milvus ----------
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=chunks
MILVUS_TIMEOUT=10

# ---------- OpenSearch ----------
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=chunks
# standard 开箱即用；装了 IK 插件的集群可改为 ik_max_word
OPENSEARCH_ANALYZER=standard

# ---------- 检索 ----------
RETRIEVE_MODE=hybrid          # vector | keyword | hybrid
TOP_K=5
VECTOR_TOP_K=20
BM25_TOP_K=20
RRF_K=60
RERANK_ENABLED=false
MIN_SCORE=0.0

# ---------- Kafka（最小闭环仅占位，USE_KAFKA=false 时走服务间同步直连） ----------
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC_RAW_DOCUMENTS=raw-documents
KAFKA_TOPIC_CHUNK_EVENTS=chunk-events
USE_KAFKA=false

# ---------- Langfuse（留空即关闭） ----------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- 鉴权（占位，AUTHZ_ENABLED=false 时使用固定身份） ----------
AUTHZ_ENABLED=false
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rag
KEYCLOAK_CLIENT_ID=rag-api
# 留空则用 client_id 作为 audience 校验值
KEYCLOAK_AUDIENCE=
OPA_URL=http://localhost:8181
# 查整个 package 才能拿到拒绝原因（单查 /allow 只有布尔）
OPA_DECISION_PATH=v1/data/rag
# 免鉴权路径（探针/静态资源/接口文档）
AUTHZ_EXEMPT_PATHS=/health,/openapi.json,/docs,/redoc,/ui

# ---- 指标（Prometheus 文本格式，各服务暴露 /metrics）----
# 全部 9 个服务都会暴露 /metrics。配了 METRICS_TOKEN 之后，**所有**服务的 /metrics
# 都要求 `Authorization: Bearer <token>`（不只是网关）——所以抓取配置的两个 job 都要带凭据。
# 不配 token 则全部直接可达（本地开发）。
# 网关额外有一层：它的 /metrics 只在配了 token 时才免**用户鉴权**（Prometheus 没有 Keycloak 令牌），
# 否则会先被身份中间件拦成 401。
METRICS_ENABLED=true
METRICS_TOKEN=
DEFAULT_TENANT_ID=default
DEFAULT_DEPARTMENT_ID=default
DEFAULT_USER_ID=u_demo

# ---------- 切分 / 语料 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
DOCS_DIR=./data/corpus

# ---------- 基础设施端口（docker compose 宿主映射） ----------
POSTGRES_PORT=5432
REDIS_PORT=6379
OPENSEARCH_PORT=9200
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
KAFKA_PORT=9092
KEYCLOAK_PORT=8180
OPA_PORT=8181
LANGFUSE_PORT=3030


# ---- 成本折算（model-gateway）----
# 单价表（USD / 1M tokens），JSON；键按最长前缀匹配响应里的模型名。
# 默认（留空时）内置 DeepSeek 官方价与本地模型 0 价；会漂移，以供应商账单为准校准。
LLM_PRICES=

# ---- 审计落库（api-gateway）----
# 留空 = 仅 stdout 审计。默认沿用 DATABASE_URL 所指的库（audit_logs 表自动创建）。
AUDIT_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
